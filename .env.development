# Development Environment Configuration
# Copy this to .env for local development

# Application Configuration
APP_NAME="URL Shortener"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Database Configuration - PostgreSQL for development
DATABASE_URL=postgresql://urlshortener_user:urlshortener_pass_dev@localhost:5432/urlshortener

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=3600

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security Configuration (DEV ONLY - DO NOT USE IN PRODUCTION)
SECRET_KEY=dev-secret-key-change-in-production-use-secrets-token-urlsafe-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Rate Limiting (Relaxed for development)
RATE_LIMIT_REDIRECT_PER_MINUTE=1000
RATE_LIMIT_API_FREE_PER_HOUR=1000
RATE_LIMIT_API_PRO_PER_HOUR=10000
RATE_LIMIT_API_ENTERPRISE_PER_HOUR=100000

# Link Settings
DEFAULT_SLUG_LENGTH=7
MAX_SLUG_LENGTH=30
MIN_SLUG_LENGTH=3
MAX_EXPIRATION_DAYS=365

# URL Validation (Relaxed for development)
MAX_URL_LENGTH=2048
ENABLE_DNS_CHECK=False
REMOVE_TRACKING_PARAMS=False

# CORS Origins (Allow all for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Monitoring
ENABLE_METRICS=True
SENTRY_DSN=

# Logging
LOG_LEVEL=DEBUG
