# Production Environment Configuration
# CRITICAL: All values must be set from secure secrets management

# Application Configuration
APP_NAME="URL Shortener"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT=production

# Database Configuration - PostgreSQL production
# REQUIRED: Set from secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# DATABASE_URL=postgresql://urlshortener_user:SECURE_PASSWORD@prod-db-host:5432/urlshortener

DB_POOL_SIZE=50
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Redis Configuration
# REQUIRED: Set from secrets manager
# REDIS_URL=redis://prod-redis-host:6379/0
REDIS_CACHE_TTL=3600

# Security Configuration
# CRITICAL: Must be generated securely and stored in secrets manager
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=MUST_BE_SET_FROM_SECRETS_MANAGER
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Rate Limiting (Production values)
RATE_LIMIT_REDIRECT_PER_MINUTE=100
RATE_LIMIT_API_FREE_PER_HOUR=100
RATE_LIMIT_API_PRO_PER_HOUR=1000
RATE_LIMIT_API_ENTERPRISE_PER_HOUR=10000

# Link Settings
DEFAULT_SLUG_LENGTH=7
MAX_SLUG_LENGTH=30
MIN_SLUG_LENGTH=3
MAX_EXPIRATION_DAYS=365

# URL Validation (Strict production settings)
MAX_URL_LENGTH=2048
ENABLE_DNS_CHECK=True
REMOVE_TRACKING_PARAMS=False

# CORS Origins (Production domains only)
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Celery Configuration
# CELERY_BROKER_URL=redis://prod-redis-host:6379/0
# CELERY_RESULT_BACKEND=redis://prod-redis-host:6379/1

# AWS S3 Configuration (for QR codes, exports)
# REQUIRED: Set from secrets manager
# AWS_ACCESS_KEY_ID=MUST_BE_SET_FROM_SECRETS_MANAGER
# AWS_SECRET_ACCESS_KEY=MUST_BE_SET_FROM_SECRETS_MANAGER
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=urlshortener-production

# Analytics Database (ClickHouse or TimescaleDB)
# CLICKHOUSE_HOST=prod-clickhouse-host
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_DATABASE=url_shortener
# CLICKHOUSE_USER=clickhouse_user
# CLICKHOUSE_PASSWORD=MUST_BE_SET_FROM_SECRETS_MANAGER

# Monitoring
ENABLE_METRICS=True
# SENTRY_DSN=https://your-production-sentry-dsn

# Stripe Configuration (Live mode)
# REQUIRED: Set from secrets manager
# STRIPE_API_KEY=sk_live_MUST_BE_SET_FROM_SECRETS_MANAGER
# STRIPE_WEBHOOK_SECRET=whsec_MUST_BE_SET_FROM_SECRETS_MANAGER

# Email Configuration (for notifications)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=MUST_BE_SET_FROM_SECRETS_MANAGER
# SMTP_FROM=noreply@yourdomain.com

# Logging
LOG_LEVEL=WARNING

# Security Headers
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=True

# Performance
WORKER_COUNT=4
WORKER_TIMEOUT=30
KEEPALIVE=5

# Backup Configuration
# BACKUP_S3_BUCKET=urlshortener-backups
# BACKUP_RETENTION_DAYS=30
