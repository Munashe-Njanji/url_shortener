# Staging Environment Configuration
# Use this for staging/testing environment

# Application Configuration
APP_NAME="URL Shortener"
APP_VERSION="1.0.0"
DEBUG=False
ENVIRONMENT=staging

# Database Configuration - PostgreSQL staging
# DATABASE_URL=postgresql://urlshortener_user:CHANGE_PASSWORD@staging-db-host:5432/urlshortener_staging

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Redis Configuration
# REDIS_URL=redis://staging-redis-host:6379/0
REDIS_CACHE_TTL=3600

# Security Configuration
# IMPORTANT: Generate secure keys for staging!
# SECRET_KEY=GENERATE_WITH_secrets_token_urlsafe_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Rate Limiting (Production-like)
RATE_LIMIT_REDIRECT_PER_MINUTE=100
RATE_LIMIT_API_FREE_PER_HOUR=100
RATE_LIMIT_API_PRO_PER_HOUR=1000
RATE_LIMIT_API_ENTERPRISE_PER_HOUR=10000

# Link Settings
DEFAULT_SLUG_LENGTH=7
MAX_SLUG_LENGTH=30
MIN_SLUG_LENGTH=3
MAX_EXPIRATION_DAYS=365

# URL Validation (Production settings)
MAX_URL_LENGTH=2048
ENABLE_DNS_CHECK=True
REMOVE_TRACKING_PARAMS=False

# CORS Origins (Staging domains)
# CORS_ORIGINS=https://staging.yourdomain.com,https://staging-admin.yourdomain.com

# Celery Configuration
# CELERY_BROKER_URL=redis://staging-redis-host:6379/0
# CELERY_RESULT_BACKEND=redis://staging-redis-host:6379/1

# AWS S3 Configuration (for QR codes, exports)
# AWS_ACCESS_KEY_ID=your_staging_access_key
# AWS_SECRET_ACCESS_KEY=your_staging_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=urlshortener-staging

# Monitoring
ENABLE_METRICS=True
# SENTRY_DSN=https://your-staging-sentry-dsn

# Stripe Configuration (Test mode)
# STRIPE_API_KEY=sk_test_your_stripe_test_key
# STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# Logging
LOG_LEVEL=INFO
